  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.9.1",
    "@remotion/bundler": "^4.0.536",
    "@remotion/cli": "^4.0.536",
    "@remotion/media": "^4.0.536",
    "@remotion/renderer": "^4.0.536",
    "edge-tts": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.536"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0"
  }
