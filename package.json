{
  "name": "remotion-ai-video-generator",
  "version": "1.0.0",
  "description": "AI-scripted animated video generator powered by Remotion, Edge-TTS, and escribe-humano",
  "type": "module",
  "scripts": {
    "dev": "remotion preview src/remotion/index.ts",
